{
  "name": "joplin-plugin-incremental-backup",
  "version": "0.1.0",
  "keywords": ["joplin-plugin"],
  "private": true,
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "postbuild": "node -e \"const fs=require('fs');fs.mkdirSync('publish',{recursive:true});fs.copyFileSync('manifest.json','publish/manifest.json');\"",
    "dev": "webpack --config webpack.config.js --mode development --watch",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "memfs": "^4.9.2",
    "ts-jest": "^29.1.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
